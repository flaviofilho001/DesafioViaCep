@model ViaCep.ViewModels.EnderecoFormViewModel
@{
    ViewData["Title"] = "Novo Endereço";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
        <h1 class="font-sora text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
            <i class="fa-solid fa-plus-circle text-indigo-600"></i> Cadastrar Novo Endereço
        </h1>
        <p class="mt-1 text-sm text-slate-500 font-sans">
            Digite o CEP para buscar o endereço automaticamente via API do ViaCEP ou insira os dados manualmente.
        </p>
    </div>

    <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm">
        <form asp-action="Criar" method="post" id="enderecoForm" class="space-y-6">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 sm:grid-cols-12 gap-6">
                <!-- CEP Field -->
                <div class="sm:col-span-4 space-y-2">
                    <label asp-for="Cep" class="block text-sm font-semibold text-slate-700">CEP</label>
                    <div class="relative rounded-xl shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-solid fa-map-pin text-sm"></i>
                        </div>
                        <input asp-for="Cep" id="inputCep" 
                               class="block w-full pl-10 pr-10 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm font-mono transition-all" 
                               placeholder="00000-000" maxlength="9" autofocus />
                        <div id="cepLoading" class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none hidden">
                            <i class="fa-solid fa-circle-notch fa-spin text-indigo-600"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Cep" class="text-xs text-rose-600 font-medium"></span>
                    <span id="cepStatus" class="text-xs font-medium block mt-1"></span>
                </div>

                <!-- Logradouro -->
                <div class="sm:col-span-8 space-y-2">
                    <label asp-for="Logradouro" class="block text-sm font-semibold text-slate-700">Logradouro</label>
                    <input asp-for="Logradouro" id="inputLogradouro" 
                           class="block w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all" 
                           placeholder="Rua, Avenida, Alameda..." />
                    <span asp-validation-for="Logradouro" class="text-xs text-rose-600 font-medium"></span>
                </div>

                <!-- Número -->
                <div class="sm:col-span-4 space-y-2">
                    <label asp-for="Numero" class="block text-sm font-semibold text-slate-700">Número</label>
                    <input asp-for="Numero" id="inputNumero" 
                           class="block w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all" 
                           placeholder="Nº (Ex: 123 ou S/N)" />
                    <span asp-validation-for="Numero" class="text-xs text-rose-600 font-medium"></span>
                </div>

                <!-- Complemento -->
                <div class="sm:col-span-8 space-y-2">
                    <label asp-for="Complemento" class="block text-sm font-semibold text-slate-700">Complemento (opcional)</label>
                    <input asp-for="Complemento" id="inputComplemento" 
                           class="block w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all" 
                           placeholder="Apto, Bloco, Casa..." />
                    <span asp-validation-for="Complemento" class="text-xs text-rose-600 font-medium"></span>
                </div>

                <!-- Bairro -->
                <div class="sm:col-span-5 space-y-2">
                    <label asp-for="Bairro" class="block text-sm font-semibold text-slate-700">Bairro</label>
                    <input asp-for="Bairro" id="inputBairro" 
                           class="block w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all" 
                           placeholder="Bairro..." />
                    <span asp-validation-for="Bairro" class="text-xs text-rose-600 font-medium"></span>
                </div>

                <!-- Cidade -->
                <div class="sm:col-span-5 space-y-2">
                    <label asp-for="Cidade" class="block text-sm font-semibold text-slate-700">Cidade</label>
                    <input asp-for="Cidade" id="inputCidade" 
                           class="block w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all" 
                           placeholder="Cidade..." />
                    <span asp-validation-for="Cidade" class="text-xs text-rose-600 font-medium"></span>
                </div>

                <!-- UF -->
                <div class="sm:col-span-2 space-y-2">
                    <label asp-for="Uf" class="block text-sm font-semibold text-slate-700">UF</label>
                    <input asp-for="Uf" id="inputUf" 
                           class="block w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm font-mono uppercase text-center transition-all" 
                           placeholder="UF" maxlength="2" />
                    <span asp-validation-for="Uf" class="text-xs text-rose-600 font-medium"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-200">
                <a asp-action="Index" 
                   class="px-5 py-3 border border-slate-300 rounded-xl text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50 transition-all">
                    Cancelar
                </a>
                <button type="submit" 
                        class="inline-flex items-center px-6 py-3 border border-transparent rounded-xl shadow-md text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all">
                    <i class="fa-solid fa-floppy-disk mr-2"></i> Salvar Endereço
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputCep = document.getElementById('inputCep');
            const cepLoading = document.getElementById('cepLoading');
            const cepStatus = document.getElementById('cepStatus');

            const inputLogradouro = document.getElementById('inputLogradouro');
            const inputBairro = document.getElementById('inputBairro');
            const inputCidade = document.getElementById('inputCidade');
            const inputUf = document.getElementById('inputUf');
            const inputNumero = document.getElementById('inputNumero');

            async function consultarViaCep(cep) {
                const cepLimpo = cep.replace(/\D/g, '');
                if (cepLimpo.length !== 8) return;

                cepLoading.classList.remove('hidden');
                cepStatus.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-indigo-500 mr-1"></i> Buscando dados no ViaCEP...';
                cepStatus.className = 'text-xs font-medium block mt-1 text-indigo-600';

                try {
                    const response = await fetch(`/api/viacep/${cepLimpo}`);
                    if (!response.ok) throw new Error('CEP não encontrado');

                    const dados = await response.json();

                    inputLogradouro.value = dados.logradouro || '';
                    inputBairro.value = dados.bairro || '';
                    inputCidade.value = dados.localidade || '';
                    inputUf.value = (dados.uf || '').toUpperCase();

                    cepStatus.innerHTML = '<i class="fa-solid fa-circle-check text-emerald-500 mr-1"></i> Endereço localizado via ViaCEP!';
                    cepStatus.className = 'text-xs font-medium block mt-1 text-emerald-600';

                    // Foco automático no número
                    inputNumero.focus();
                } catch (error) {
                    cepStatus.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-amber-500 mr-1"></i> CEP não localizado no ViaCEP. Preencha manualmente.';
                    cepStatus.className = 'text-xs font-medium block mt-1 text-amber-600';
                } finally {
                    cepLoading.classList.add('hidden');
                }
            }

            inputCep.addEventListener('blur', function () {
                consultarViaCep(this.value);
            });

            inputCep.addEventListener('input', function () {
                const cepLimpo = this.value.replace(/\D/g, '');
                if (cepLimpo.length === 8) {
                    consultarViaCep(this.value);
                }
            });
        });
    </script>
}
