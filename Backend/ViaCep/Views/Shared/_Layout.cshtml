<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ViaCEP Manager</title>

    <!-- Google Fonts: Sora (Títulos) e DM Sans (Corpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Sora:wght@100..800&display=swap" rel="stylesheet">

    <!-- Font Awesome 6 (Icons) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Tailwind CSS v3 via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sora: ['Sora', 'sans-serif'],
                        sans: ['DM Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Sora', sans-serif;
        }
        body {
            font-family: 'DM Sans', sans-serif;
        }
    </style>
</head>
<body class="flex flex-col min-h-full bg-slate-50 text-slate-800 antialiased font-sans">
    <!-- Navbar Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2.5 font-sora font-bold text-xl text-indigo-600 hover:text-indigo-700 transition-colors">
                <span class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 text-lg shadow-sm">
                    <i class="fa-solid fa-location-dot"></i>
                </span>
                <span>ViaCEP<span class="text-slate-900">Manager</span></span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex items-center gap-4">
                    <div class="hidden sm:flex items-center gap-2 text-sm text-slate-600 bg-slate-100/80 px-3 py-1.5 rounded-lg border border-slate-200/60">
                        <i class="fa-regular fa-user text-indigo-500"></i>
                        <span>Olá, <strong class="font-semibold text-slate-900">@User.Identity.Name</strong></span>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex items-center justify-center px-3.5 py-1.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all shadow-sm">
                            <i class="fa-solid fa-right-from-bracket mr-2 text-slate-400"></i> Sair
                        </button>
                    </form>
                </div>
            }
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["Sucesso"] != null)
        {
            <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center gap-3 shadow-sm animate-fade-in">
                <i class="fa-solid fa-circle-check text-emerald-500 text-lg"></i>
                <span class="font-medium text-sm">@TempData["Sucesso"]</span>
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 flex items-center gap-3 shadow-sm animate-fade-in">
                <i class="fa-solid fa-triangle-exclamation text-rose-500 text-lg"></i>
                <span class="font-medium text-sm">@TempData["Erro"]</span>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
            <p>&copy; @DateTime.Now.Year ViaCEP Manager - Desenvolvido com <i class="fa-solid fa-code text-indigo-500 mx-0.5"></i> C# .NET 9, ASP.NET Core MVC &amp; Tailwind CSS</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
