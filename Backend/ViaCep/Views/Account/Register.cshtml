@model ViaCep.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Criar Conta";
}

<div class="min-h-[80vh] flex items-center justify-center py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl border border-slate-200/80 p-8 space-y-6">
        <div class="text-center">
            <div class="w-16 h-16 bg-indigo-50 border border-indigo-100 rounded-2xl flex items-center justify-center text-indigo-600 text-2xl mx-auto shadow-inner mb-4">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h2 class="font-sora text-2xl font-bold text-slate-900 tracking-tight">
                Criar Nova Conta
            </h2>
            <p class="mt-2 text-sm text-slate-500 font-sans">
                Preencha os dados abaixo para se cadastrar no sistema.
            </p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm space-y-1">
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-circle-exclamation text-rose-500"></i>
                            <span>@error.ErrorMessage</span>
                        </div>
                    }
                </div>
            }

            <!-- Nome Completo -->
            <div class="space-y-1.5">
                <label asp-for="Nome" class="block text-sm font-semibold text-slate-700"></label>
                <div class="relative rounded-xl shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-id-card text-sm"></i>
                    </div>
                    <input asp-for="Nome" 
                           class="block w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all"
                           placeholder="Seu nome completo..." 
                           autofocus />
                </div>
                <span asp-validation-for="Nome" class="text-xs text-rose-600 font-medium"></span>
            </div>

            <!-- Nome de Usuário -->
            <div class="space-y-1.5">
                <label asp-for="NomeUsuario" class="block text-sm font-semibold text-slate-700"></label>
                <div class="relative rounded-xl shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-at text-sm"></i>
                    </div>
                    <input asp-for="NomeUsuario" 
                           class="block w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all"
                           placeholder="Nome de usuário..." />
                </div>
                <span asp-validation-for="NomeUsuario" class="text-xs text-rose-600 font-medium"></span>
            </div>

            <!-- Senha -->
            <div class="space-y-1.5">
                <label asp-for="Senha" class="block text-sm font-semibold text-slate-700"></label>
                <div class="relative rounded-xl shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-lock text-sm"></i>
                    </div>
                    <input asp-for="Senha" 
                           class="block w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all"
                           placeholder="••••••••" />
                </div>
                <span asp-validation-for="Senha" class="text-xs text-rose-600 font-medium block"></span>
                <p class="text-[11px] text-slate-500 mt-1 leading-tight">
                    <i class="fa-solid fa-shield-halved text-indigo-500 mr-1"></i>
                    Mínimo 8 caracteres: maiúscula, minúscula, número e símbolo (!@@#$%^&*).
                </p>
            </div>

            <!-- Confirmar Senha -->
            <div class="space-y-1.5">
                <label asp-for="ConfirmarSenha" class="block text-sm font-semibold text-slate-700"></label>
                <div class="relative rounded-xl shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-check-double text-sm"></i>
                    </div>
                    <input asp-for="ConfirmarSenha" 
                           class="block w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all"
                           placeholder="••••••••" />
                </div>
                <span asp-validation-for="ConfirmarSenha" class="text-xs text-rose-600 font-medium"></span>
            </div>

            <button type="submit" 
                    class="w-full flex items-center justify-center py-3 px-4 border border-transparent rounded-xl shadow-md text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all transform active:scale-[0.99] mt-2">
                <i class="fa-solid fa-user-check mr-2"></i> Finalizar Cadastro
            </button>

            <div class="text-center pt-2 border-t border-slate-100">
                <span class="text-xs text-slate-500">Já possui uma conta?</span>
                <a asp-action="Login" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700 ml-1">
                    Fazer Login
                </a>
            </div>
        </form>
    </div>
</div>
